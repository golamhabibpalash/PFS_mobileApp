# Source nvm if available (for Xcode Cloud)
if [ -f "$HOME/.nvm/nvm.sh" ]; then
  \. "$HOME/.nvm/nvm.sh" 2>/dev/null
fi

# Find node binary: prefer existing NODE_BINARY, then PATH lookup, then fallback
if [ -z "$NODE_BINARY" ]; then
  if command -v node &> /dev/null; then
    export NODE_BINARY=$(command -v node)
  elif [ -x /opt/homebrew/bin/node ]; then
    export NODE_BINARY=/opt/homebrew/bin/node
  else
    export NODE_BINARY=$(command -v node || echo "/opt/homebrew/bin/node")
  fi
fi
